# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/charisbot

# JWT
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_segura_32chars
JWT_EXPIRES_IN=7d

# WhatsApp API
WA_PHONE_NUMBER_ID=886423901225348
WA_ACCESS_TOKEN=tu_token_de_whatsapp_aqui
WA_API_VERSION=v22.0

# N8n webhook para notificaciones
N8N_WEBHOOK_URL=https://tu-n8n.com/webhook/charisbot-portal

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# Stripe (deja vacío hasta tener credenciales reales — el switch en /admin/config
# permanece apagado mientras STRIPE_SECRET_KEY no esté presente)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (idem — el switch se activa al detectar MP_ACCESS_TOKEN)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
